# Copy to .env (git-ignored).
# API base URL (the BE listens on 5187 locally)
VITE_API_BASE_URL=http://localhost:5187/api
# true = every request is answered by src/mocks (no backend needed)
VITE_USE_MOCK=true

# Public image bucket (read-only URLs, no key needed). Uploads go through the BE, not the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_BUCKET=images

# VietMap (map + geocoding); restrict both keys to your domains in the VietMap dashboard
VITE_VIETMAP_API_KEY=
VITE_VIETMAP_TILEMAP_KEY=
